{
  "name": "garmin-personal-api-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:docs": "pnpm --filter docs dev",
    "dev:mcp": "pnpm --filter @trainingloadai/garmin-personal-api-mcp dev",
    "lint": "eslint .",
    "pack:mcp": "pnpm --filter @trainingloadai/garmin-personal-api-mcp pack",
    "smoke:pack": "node scripts/smoke-packed.mjs",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
